# AI Career Matcher — environment configuration for docker compose.
# Copy to .env and replace every "change-me" value:  cp .env.example .env
# Generate secrets with:  openssl rand -hex 32

# ---- General ----
APP_ENV=dev

# ---- PostgreSQL ----
POSTGRES_DB=careermatcher
POSTGRES_USER=careermatcher
POSTGRES_PASSWORD=change-me
# Host port for local tools (psql, IDE). Bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432

# ---- Backend (Spring Boot) ----
BACKEND_HOST_PORT=8080
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Swagger UI / OpenAPI JSON. Set false in production.
OPENAPI_ENABLED=true
APP_LOG_LEVEL=INFO

# Access-token signing key (HS256). At least 32 bytes; generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-bytes
# Refresh-token cookie "Secure" flag. Must be true when served over HTTPS (any real deployment);
# false only for plain-http localhost development.
COOKIE_SECURE=false
# Set to "native" only behind a trusted reverse proxy that sets X-Forwarded-For (rate limiting by IP).
FORWARD_HEADERS_STRATEGY=none

# Per-IP rate limits. Defaults suit production; raise locally when running E2E tests, since all
# local traffic shares one IP.
RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=20

RATE_LIMIT_CV_UPLOADS_PER_HOUR=10

# ---- Administration ----
# First administrator, created on startup if no account with this e-mail exists (never promotes
# an existing account). Password: 12-128 chars with a letter and a digit. After the first
# sign-in, change the password in Settings and remove ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Load the bundled DEMO job listings (fictional companies, example.com links, clearly labelled).
# Useful for development and demos. Keep false in production.
JOBS_DEMO_DATA_ENABLED=false

# ---- CV file storage (SeaweedFS, S3-compatible; private, never exposed) ----
STORAGE_ACCESS_KEY=change-me-storage-access-key
STORAGE_SECRET_KEY=change-me-storage-secret-key
STORAGE_BUCKET=career-matcher-cvs
# AES-256 key (base64 of 32 random bytes) used to encrypt every CV before it is stored.
# Generate with: openssl rand -base64 32  (losing it makes stored CVs unreadable)
CV_ENCRYPTION_KEY=change-me-base64-32-bytes

# ---- AI service (FastAPI) ----
# Shared secret between backend and AI service. Minimum 32 characters.
AI_INTERNAL_TOKEN=change-me-to-a-random-value-of-at-least-32-chars
AI_LOG_LEVEL=INFO
# "anthropic" (Claude; needs ANTHROPIC_API_KEY), "ollama" (a local model served by Ollama on this
# machine; dev only, no key) or "local" (offline rule-based extractor: skills and education only).
# Use anthropic in production.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# AI_PROVIDER=ollama: run Ollama natively (`ollama serve`; Docker on macOS has no GPU access) and
# pull the model first (`ollama pull qwen2.5:7b`). The container reaches it via host.docker.internal.
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Local models are slower: per-call timeout in the AI service, and the backend's wait for it.
# AI_TIMEOUT_SECONDS=120
# AI_ANALYSIS_TIMEOUT=180s
# Interactive docs at /docs. Dev only.
AI_DOCS_ENABLED=true
# Host port, bound to 127.0.0.1 only, for local debugging. Not exposed in production.
AI_HOST_PORT=8000

# ---- Frontend (Next.js) ----
FRONTEND_HOST_PORT=3000
# Backend URL as seen by the user's browser (baked into the frontend image at build time).
# Must be same-site with the frontend so the SameSite=Strict refresh cookie is sent.
PUBLIC_API_BASE_URL=http://localhost:8080

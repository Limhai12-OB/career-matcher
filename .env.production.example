# AI Career Matcher: PRODUCTION environment.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Replace every value marked CHANGE. Never commit .env.production. Keep a copy of the secrets in a
# password manager / secret store: losing CV_ENCRYPTION_KEY makes every stored CV unreadable.
# See docs/DEPLOYMENT.md for the full checklist.

# ---- General ----
APP_ENV=production

# ---- Public domains (DNS A/AAAA records must point at this host before the first start) ----
# The two hosts must share a registrable domain (same site) so the SameSite=Strict refresh cookie
# is sent: e.g. app.example.org + api.example.org.
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org
# Caddy global options. "email <address>" registers the ACME account for certificate expiry notices.
CADDY_GLOBAL_OPTIONS=email CHANGE-ops@example.org

# ---- PostgreSQL ----
POSTGRES_DB=careermatcher
POSTGRES_USER=careermatcher
# CHANGE: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE

# ---- Backend ----
# CHANGE: openssl rand -hex 32   (rotating it signs everyone out)
JWT_SECRET=CHANGE
APP_LOG_LEVEL=INFO
RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=20
RATE_LIMIT_CV_UPLOADS_PER_HOUR=10
RATE_LIMIT_EXPLANATIONS_PER_HOUR=30
RATE_LIMIT_GAP_REPORTS_PER_HOUR=20
RATE_LIMIT_ROADMAPS_PER_HOUR=10
# Matching weights (must sum to 1.0). Changing them changes every candidate's scores.
MATCH_WEIGHT_SKILLS=0.45
MATCH_WEIGHT_EXPERIENCE=0.20
MATCH_WEIGHT_PROJECTS=0.15
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_PREFERENCES=0.10
# Fictional demo listings. Keep false unless you are running a demo (they are labelled DEMO).
JOBS_DEMO_DATA_ENABLED=false

# ---- First administrator ----
# Created on first start if the e-mail doesn't exist (never promotes an existing account).
# Production requires >= 16 characters. Sign in, change the password in Settings, then REMOVE
# ADMIN_PASSWORD from this file and restart the backend.
ADMIN_EMAIL=CHANGE-admin@example.org
ADMIN_PASSWORD=CHANGE

# ---- CV storage (private; never published) ----
# CHANGE: openssl rand -hex 10   /   openssl rand -hex 24
STORAGE_ACCESS_KEY=CHANGE
STORAGE_SECRET_KEY=CHANGE
STORAGE_BUCKET=career-matcher-cvs
# CHANGE: openssl rand -base64 32   (AES-256 key for every CV; back it up separately from the data)
CV_ENCRYPTION_KEY=CHANGE

# ---- AI service ----
# CHANGE: openssl rand -hex 32
AI_INTERNAL_TOKEN=CHANGE
AI_LOG_LEVEL=INFO
# anthropic = full CV analysis, explanations and roadmaps with Claude.
# local = offline basic mode (skills and education only; template explanations/roadmaps).
AI_PROVIDER=anthropic
# CHANGE: Anthropic API key (server-side only; never sent to browsers)
ANTHROPIC_API_KEY=CHANGE
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
